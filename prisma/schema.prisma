// Pre-Loved Auction — data model
// One app, many auction events. Each event has its own items, its own
// fundraising goal, and its own running total, so the chapter can run a
// fresh auction whenever it likes and the total starts back at zero.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Can browse and bid. Everyone starts here.
  BIDDER
  /// Collects donations: adds and edits items, uploads photos. Cannot open or
  /// close an auction, and cannot see winners' contact details or payments.
  ///
  /// Shown as "Cataloger". The stored value keeps its original spelling
  /// deliberately: renaming an enum value is a destructive change that the
  /// deploy's schema step refuses, and nobody ever sees this identifier.
  CATALOGUER
  /// Handles the money afterwards: the winners report, marking paid and
  /// collected, the CSV export. Cannot change items or auctions.
  TREASURER
  /// Everything, including granting these roles.
  ADMIN
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ItemStatus {
  DRAFT
  LIVE
  ENDED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum HandoverStatus {
  PENDING
  COLLECTED
}

/// Where a bid came from, so the record shows how a lot was won.
enum BidChannel {
  /// Placed by a signed-in bidder from their own device.
  ONLINE
  /// Called in the room and entered by the operator running the live auction.
  ROOM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  role      Role     @default(BIDDER)

  /// scrypt hash. Null for accounts created before passwords existed, which
  /// set one through the "forgot password" flow.
  passwordHash String?

  /// Slows down guessing. Cleared on a successful sign-in.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids      Bid[]
  watches   Watch[]
  wonItems  Item[]  @relation("ItemWinner")

  @@index([role])
}

/// A single-use, hashed password-reset token. Deleted once used or expired.
/// Named LoginToken for historical reasons — renaming the table would be a
/// destructive migration against a live database for no functional gain.
model LoginToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// One fundraising auction. Create a new one for each drive; its goal and
/// total are scoped to the event, so "raised so far" restarts at zero.
model AuctionEvent {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  tagline       String?
  description   String?
  currency      String      @default("PHP")
  goalCents     Int         @default(0)
  status        EventStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  /// Shown to winners on their account page and in the "you won" email.
  paymentInstructions String?
  pickupInstructions  String?

  /// Shown on the lots that are being saved for the live finale.
  liveNote     String?
  /// The lot the auctioneer is on right now. Null when no lot is running.
  currentLotId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items Item[]

  @@index([status])
}

model Item {
  id                String     @id @default(cuid())
  eventId           String
  event             AuctionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  category          String?
  condition         String?
  /// Who provided the item — shown on the listing to credit the member.
  donorName         String?
  imageUrls         String[]   @default([])

  startingBidCents  Int        @default(0)
  bidIncrementCents Int        @default(5000)
  /// Optional hidden minimum. If the top bid is below it, the item does not sell.
  reserveCents      Int?

  endsAt            DateTime
  status            ItemStatus @default(DRAFT)

  /// Held back for the live finale instead of closing at endsAt. Online bids
  /// still run beforehand and set the opening price.
  isLiveLot         Boolean    @default(false)
  /// The order the auctioneer works through the live lots.
  lotNumber         Int?

  winnerId          String?
  winner            User?      @relation("ItemWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  /// Set instead of winnerId when a lot is won in the room by someone without
  /// an account — "Paddle 12", or a name the operator typed.
  winnerLabel       String?
  winningBidCents   Int?
  paymentStatus     PaymentStatus  @default(UNPAID)
  handoverStatus    HandoverStatus @default(PENDING)
  adminNotes        String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  bids    Bid[]
  watches Watch[]

  @@index([eventId, status])
  @@index([status, endsAt])
  @@index([winnerId])
}

model Bid {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Null for a room bid from someone without an account.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// How the operator identified a room bidder who has no account.
  bidderLabel String?

  channel    BidChannel @default(ONLINE)
  amountCents Int
  createdAt  DateTime @default(now())

  @@index([itemId, amountCents])
  @@index([userId])
}

model Watch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([itemId])
}
