# ---- Required ----
# Postgres connection string. On Vercel, add a Neon/Vercel Postgres database
# and this variable is filled in for you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the deployed app, used to build magic-link URLs.
APP_URL="https://your-app.vercel.app"

# Emails (comma separated) that are automatically made admins when they log in.
# Put the chapter organisers here.
ADMIN_EMAILS="organiser@example.com"

# ---- Optional ----
# Resend API key for sending login links, outbid alerts and winner emails.
# Without it the app still works: emails are printed to the server log instead.
# Free tier: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="CFC SB3E Auction <onboarding@resend.dev>"

# Secret for the scheduled job that closes finished items (Vercel Cron sends it
# automatically as a Bearer token). Generate with: openssl rand -base64 32
CRON_SECRET=""

# Vercel Blob storage token for photo uploads. Without it, uploads are written
# to ./public/uploads, which works locally but not on Vercel.
BLOB_READ_WRITE_TOKEN=""
