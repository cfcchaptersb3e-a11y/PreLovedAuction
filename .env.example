# ---- Required ----
# Postgres connection string. On Vercel, add a Neon/Vercel Postgres database
# and this variable is filled in for you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the deployed app, used to build magic-link URLs.
APP_URL="https://your-app.vercel.app"

# Emails (comma separated) that are automatically made admins when they log in.
# Put the chapter organisers here.
ADMIN_EMAILS="organiser@example.com"

# ---- Optional ----
# Email. Set ONE of these; without either, messages are printed to the server
# log instead and the app still works (but nobody can receive a sign-in link).
#
# Brevo — verifies a single sender address, so no domain is needed. Add the
# chapter's own address under Senders in Brevo, confirm the emailed code, then
# set EMAIL_FROM to exactly that address. Free tier: 300 emails/day.
BREVO_API_KEY=""
#
# Resend — needs a verified sending DOMAIN. Until you have one it will only
# deliver to the Resend account owner's own inbox.
RESEND_API_KEY=""
#
# The address messages are sent from. With Brevo this must be a verified
# sender; with Resend it must be at a verified domain.
EMAIL_FROM="CFC SB3E Auction <chapter@example.com>"

# Secret for the scheduled job that closes finished items (Vercel Cron sends it
# automatically as a Bearer token). Generate with: openssl rand -base64 32
CRON_SECRET=""

# Vercel Blob storage token for photo uploads. Without it, uploads are written
# to ./public/uploads, which works locally but not on Vercel.
BLOB_READ_WRITE_TOKEN=""
